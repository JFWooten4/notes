{
  "name": "notes",
  "private": true,
  "version": "0.1.0",
  "description": "Docusaurus site for public working notes",
  "scripts": {
    "sync:notes": "node scripts/sync-notes.mjs",
    "docusaurus": "docusaurus",
    "start": "npm run sync:notes && docusaurus start",
    "build": "npm run sync:notes && docusaurus build",
    "serve": "docusaurus serve",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@docusaurus/core": "3.6.3",
    "@docusaurus/faster": "3.6.3",
    "@docusaurus/preset-classic": "3.6.3",
    "@mdx-js/react": "3.0.1",
    "clsx": "2.1.1",
    "prism-react-renderer": "2.4.1",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@docusaurus/module-type-aliases": "3.6.3",
    "@docusaurus/tsconfig": "3.6.3",
    "@docusaurus/types": "3.6.3",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "typescript": "5.6.3"
  },
  "engines": {
    "node": ">=20"
  }
}
